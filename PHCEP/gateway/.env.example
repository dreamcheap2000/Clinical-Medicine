# Runtime environment only. Replace placeholders using your secret manager.
LINE_CHANNEL_SECRET=
GATEWAY_SIGNING_SECRET=
PHCEP_BACKEND_MODE=APPS_SCRIPT
PHCEP_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_DEPLOYMENT_ID/exec
PHCEP_SPRING_BOOT_URL=https://REPLACE_TRUSTED_INTERNAL_HOST/internal/events
PORT=8080

# Add patient routes to this SAME Render service. Keep existing LINE values.
# Leave false until the patient Sheet and its credentials are ready.
PATIENT_API_ENABLED=false
PATIENT_API_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_CLINICIAN_TOKEN
PATIENT_BACKEND=GOOGLE_SHEETS
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"REPLACE_SERVICE_ACCOUNT_EMAIL","private_key":"REPLACE_PRIVATE_KEY"}
GOOGLE_SHEET_ID=REPLACE_GOOGLE_SHEET_ID
GOOGLE_SHEET_TAB=NHI高血脂個案

# Optional APPS_SCRIPT patient adapter only; not the existing LINE events endpoint.
PHCEP_PATIENT_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_PATIENT_DEPLOYMENT_ID/exec
PATIENT_APPS_SCRIPT_SIGNING_SECRET=REPLACE_WITH_SEPARATE_SERVER_SIGNING_SECRET

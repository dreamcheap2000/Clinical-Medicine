# A NEW service and database. Never reuse LINE or prototype NHI credentials.
PORT=8080
PUBLIC_ORIGIN=https://REPLACE_NEW_SERVICE.onrender.com
DATABASE_URL=postgresql://REPLACE
# base64 of 32 random bytes; persist in your secret manager
DATA_ENCRYPTION_KEY=REPLACE
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
# Comma-separated actual installed Edge extension IDs, no wildcards
EXTENSION_IDS=REPLACE
# Enable only after institutional authorization for external clinical data processing.
CLINICAL_DATA_ENABLED=false
